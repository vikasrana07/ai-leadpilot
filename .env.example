# --- Database (two roles: owner runs migrations, app role is subject to RLS) ---
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_OWNER_URL=postgresql://leadpilot_owner:change-me-dev-only@localhost:5433/leadpilot
DATABASE_URL=postgresql://leadpilot_app:change-me-app-dev-only@localhost:5433/leadpilot
DATABASE_SHADOW_URL=postgresql://postgres:change-me-dev-only@localhost:5433/leadpilot_shadow
APP_ROLE_PASSWORD=change-me-app-dev-only

# --- Redis ---
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3100
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# 32 bytes base64 for local envelope-encryption master key. Prod uses KMS.
LOCAL_MASTER_KEY=

# --- WhatsApp / public URLs ---
# mock = in-memory provider for dev and tests. live = real Meta Graph API (REQUIRED in production, refuses to start with mock).
WHATSAPP_MODE=mock
WHATSAPP_GRAPH_VERSION=v21.0
# WhatsApp Embedded Signup (ADR-0012). off = disabled. mock = offline stand-in (dev/test only, needs META_APP_SECRET).
# live needs all four META_* values, WHATSAPP_MODE=live and a registered Meta Tech Provider app. Never commit real values.
EMBEDDED_SIGNUP_MODE=off
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Public base URL shown to customers in webhook URLs and the widget snippet (Meta needs a public HTTPS address)
# PUBLIC_API_URL=https://api.example.com

# --- Mail (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM=LeadPilot <no-reply@leadpilot.local>

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Object storage (MinIO locally; S3 in production) ---
MINIO_ROOT_USER=leadpilot
MINIO_ROOT_PASSWORD=change-me-minio-dev-only
MINIO_HOST_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=leadpilot-files
S3_ACCESS_KEY=leadpilot
S3_SECRET_KEY=change-me-minio-dev-only
S3_FORCE_PATH_STYLE=true

# --- Virus scanning: clamav | mock (dev/test only; production refuses mock) ---
VIRUS_SCAN_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310

# --- AI ---
# mock = deterministic offline provider for dev/tests. openai = real OpenAI API (production requires this).
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_KILL_SWITCH=false
AI_DEFAULT_MONTHLY_TOKEN_CAP=2000000

# --- Background work (phase 5) ---
# true = this process runs the outbox relay, BullMQ workers and the minute scheduler. Leave false on API replicas and run apps/worker instead.
WORKERS_ENABLED=false
QUEUE_PREFIX=leadpilot
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_RETRY_BASE_MS=2000

# --- Billing & platform console (phase 6) ---
# mock = local fake provider with real HMAC webhook signatures (not allowed in production). live = Razorpay (use TEST-mode keys first).
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same value in Razorpay Dashboard > Webhooks (URL: <PUBLIC_API_URL>/webhooks/razorpay). Events: subscription.* and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
# Plan every new workspace starts on (as a trial). `internal` = unmetered, no billing (self-hosted/dev).
SIGNUP_PLAN=internal
BILLING_GRACE_DAYS=7
# Printed on GST invoices. SELLER_STATE_CODE decides CGST+SGST (same state) vs IGST. Confirm INVOICE_SAC with your chartered accountant.
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_STATE_CODE=29
SELLER_ADDRESS=
INVOICE_SAC=998314
# Platform console auth secret (>= 32 chars; openssl rand -base64 48). Unset = console disabled.
PLATFORM_JWT_SECRET=

# --- Phase 7 ---
# Optional SMTP auth (e.g. Amazon SES SMTP credentials; set both). Port 587 = STARTTLS, 465 = implicit TLS.
SMTP_USER=
SMTP_PASS=
# One JSON access-log line per request. Default: on in production, off in development.
# ACCESS_LOG=true
# --- Monitoring (docs/monitoring.md) ---
# Application log format: json (default in production) or pretty (default elsewhere), and the minimum level.
# LOG_FORMAT=json
LOG_LEVEL=log
# CloudWatch Embedded Metric Format lines once a minute (default: on in production), alert rules + email to platform admins.
# METRICS_EMF=true
# METRICS_INTERVAL_SECONDS=60
ALERTS_ENABLED=false
# Comma-separated alert recipients; empty = every active platform admin.
ALERT_EMAIL_TO=
ALERT_REPEAT_HOURS=6

# --- Phase 8: security launch blockers ---
# Master key for envelope encryption of stored secrets (WhatsApp tokens, MFA secrets). local = LOCAL_MASTER_KEY; kms = AWS KMS.
# Production refuses `local` unless ALLOW_LOCAL_KEY_IN_PRODUCTION=true. Migrate existing records with: node dist/scripts/rewrap-secrets.js
KEY_PROVIDER=local
KMS_KEY_ID=
KMS_REGION=
ALLOW_LOCAL_KEY_IN_PRODUCTION=false
# Bot check on register / login / forgot-password / widget sessions. off | mock (token "mock-pass", dev/test only) | live (Cloudflare Turnstile).
# The web app needs NEXT_PUBLIC_TURNSTILE_SITE_KEY at BUILD time (use the same site key, or `mock` with TURNSTILE_MODE=mock).
TURNSTILE_MODE=off
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_ALLOW_OFF_IN_PRODUCTION=false
# Hold platform admins without MFA at the Security page (recommended in production).
PLATFORM_REQUIRE_MFA=false

# --- Phase 8: public API and outbound webhooks ---
API_KEY_RATE_LIMIT_PER_MIN=120
# Local testing ONLY: allow http:// and private-network webhook targets. Rejected when NODE_ENV=production.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_MS=30000
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_DISABLE_AFTER=10
