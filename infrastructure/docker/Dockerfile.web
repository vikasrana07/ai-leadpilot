# syntax=docker/dockerfile:1
# Next.js web app. NEXT_PUBLIC_API_URL is inlined into the browser bundle AT BUILD TIME, so build one image per environment:
#   docker build -f infrastructure/docker/Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=https://api.example.com -t leadpilot-web .
# (It is a public URL, not a secret.) Uses `next start` from a pruned production tree: `output: 'standalone'` is NOT enabled in
# apps/web/next.config.ts (see docs/deployment.md for the optional change that makes the image smaller).

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /repo

FROM base AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@leadpilot/web..." build
RUN pnpm --filter @leadpilot/web deploy --legacy --prod /out \
 && cp -r apps/web/.next /out/.next

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3100 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /out /app
USER node
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node_modules/.bin/next", "start", "--port", "3100"]
