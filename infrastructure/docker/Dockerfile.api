# syntax=docker/dockerfile:1
# One image for BOTH the API and the worker (same code, different command):
#   API:    node apps/api/dist/main.js            (default CMD)
#   Worker: node apps/api/dist/worker.js          (sets WORKERS_ENABLED=true itself; no HTTP listener)
#   Migrate (one-off, as the schema OWNER): see docs/deployment.md
# Build from the repo root:  docker build -f infrastructure/docker/Dockerfile.api -t leadpilot-api .
# No secrets are baked in: everything comes from environment variables at runtime.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
# Builds @leadpilot/{shared-types,validation,database} (prisma generate + tsc) and then the API.
RUN pnpm --filter "@leadpilot/api..." build
# Self-contained production tree (prod dependencies only, workspace packages copied in).
RUN pnpm --filter @leadpilot/api deploy --legacy --prod /out

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out /app
USER node
EXPOSE 4000
# Liveness only (the process answers HTTP). Readiness (/health/ready) checks the database and is what a load balancer should use.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
