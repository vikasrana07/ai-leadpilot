{
  "name": "leadpilot",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @leadpilot/database generate",
    "db:migrate": "pnpm --filter @leadpilot/database migrate",
    "db:seed": "pnpm --filter @leadpilot/database seed",
    "db:studio": "pnpm --filter @leadpilot/database run studio",
    "codegen:api": "tsc -p apps/api/tsconfig.build.json && node --env-file=.env apps/api/dist/generate-openapi.js && orval --config ./orval.config.cjs",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "format:check": "echo \"no formatter configured\"",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "orval": "^8.48.0",
    "pg": "^8.23.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
