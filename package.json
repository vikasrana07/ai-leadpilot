{
  "name": "leadpilot",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @leadpilot/database generate",
    "db:migrate": "pnpm --filter @leadpilot/database migrate",
    "db:seed": "pnpm --filter @leadpilot/database seed",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
