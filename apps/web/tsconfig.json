{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "node_modules/.cache/next-e2e/types/**/*.ts",
    "node_modules/.cache/next-e2e/dev/types/**/*.ts",
    "node_modules/.cache/next-f2/types/**/*.ts",
    "node_modules/.cache/next-f2/dev/types/**/*.ts",
    "node_modules/.cache/next-f3/types/**/*.ts",
    "node_modules/.cache/next-f3/dev/types/**/*.ts",
    ".next-polish/types/**/*.ts",
    ".next-polish/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
