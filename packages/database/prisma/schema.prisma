generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Conventions (see docs/decisions/0001): UUID ids generated app-side (UUIDv7), UTC timestamps,
// tenant_id on every tenant-owned table with RLS (see migrations/*_rls).

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String
  phone           String?
  logoUrl         String?      @map("logo_url")
  industry        String
  industryPackId  String       @default("real_estate") @map("industry_pack_id")
  website         String?
  address         String?
  timezone        String       @default("Asia/Kolkata")
  currency        String       @default("INR")
  planKey         String       @default("internal") @map("plan_key")
  status          TenantStatus @default(ACTIVE)
  settings        Json         @default("{}")
  onboardingState Json         @default("{}") @map("onboarding_state")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]
  stages      PipelineStage[]
  leads       Lead[]
  properties  Property[]

  @@map("tenants")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  name            String
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships              Membership[]
  sessions                 Session[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

// Global catalogue of permission keys (read-only for the app role).
model Permission {
  key         String           @id
  description String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String // owner | manager | agent (system roles) or custom [LATER]
  name      String
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String    @db.Citext
  roleId     String    @map("role_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id])

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("invitations")
}

// Global. Refresh tokens are opaque, stored hashed. family_id groups a rotation chain for reuse detection.
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only: the app role has INSERT + SELECT only (see RLS migration).
// Partitioned monthly by created_at in PostgreSQL.
model AuditLog {
  id           String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json     @default("{}")
  requestId    String?  @map("request_id")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([id, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending") // pending | processed | failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([tenantId])
  @@map("outbox_events")
}


// ======================================================================= Phase 2: CRM

enum StageKind {
  OPEN
  WON
  LOST
}

enum Temperature {
  HOT
  WARM
  COLD
  UNKNOWN
}

enum BuyingTimeline {
  UNKNOWN
  IMMEDIATE
  WITHIN_30_DAYS
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_PLUS_MONTHS
}

enum PropertyStatus {
  AVAILABLE
  HELD
  SOLD
}

// One pipeline per tenant in the MVP. Stages come from the Industry Pack and are tenant-editable.
model PipelineStage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  position    Int
  kind        StageKind @default(OPEN)
  /** A lead counts as "qualified" once it is at (or past) a stage with this flag. */
  qualifies   Boolean   @default(false)
  /** A lead may be moved to a WON stage only from stages with this flag (prevents skipping the sales process). */
  canCloseWon Boolean   @default(false) @map("can_close_won")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, key])
  @@index([tenantId, position])
  @@map("pipeline_stages")
}

model LostReason {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  position Int
  active   Boolean @default(true)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lost_reasons")
}

model LeadSource {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  key      String
  name     String
  isSystem Boolean @default(false) @map("is_system")

  leads Lead[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("lead_sources")
}

model CustomFieldDefinition {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  entity    String  @default("lead")
  key       String
  label     String
  type      String // text | number | select | date | boolean
  options   Json    @default("[]")
  required  Boolean @default(false)
  position  Int     @default(0)

  @@unique([tenantId, entity, key])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

model Lead {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  name                 String
  phone                String?
  /** Normalised E.164-ish digits used for duplicate detection. */
  phoneNorm            String?        @map("phone_norm")
  email                String?
  emailNorm            String?        @map("email_norm")
  sourceId             String?        @map("source_id") @db.Uuid
  stageId              String         @map("stage_id") @db.Uuid
  temperature          Temperature    @default(UNKNOWN)
  /** Money is stored in minor units (paise). The API exposes major units. */
  budgetMinMinor       BigInt?        @map("budget_min_minor")
  budgetMaxMinor       BigInt?        @map("budget_max_minor")
  location             String?
  propertyType         String?        @map("property_type")
  requirements         String?
  buyingTimeline       BuyingTimeline @default(UNKNOWN) @map("buying_timeline")
  assignedMembershipId String?        @map("assigned_membership_id") @db.Uuid
  score                Int?
  scoreUpdatedAt       DateTime?      @map("score_updated_at") @db.Timestamptz(3)
  lastContactedAt      DateTime?      @map("last_contacted_at") @db.Timestamptz(3)
  nextFollowUpAt       DateTime?      @map("next_follow_up_at") @db.Timestamptz(3)
  customFields         Json           @default("{}") @map("custom_fields")
  /// A manager set the score by hand; automatic scoring records history but does not change `score` until the override is cleared
  scoreOverridden      Boolean        @default(false) @map("score_overridden")
  siteVisitRequested   Boolean        @default(false) @map("site_visit_requested")
  lostReasonId         String?        @map("lost_reason_id") @db.Uuid
  lostNote             String?        @map("lost_note")
  mergedIntoId         String?        @map("merged_into_id") @db.Uuid
  createdByUserId      String?        @map("created_by_user_id") @db.Uuid
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage       PipelineStage   @relation(fields: [stageId], references: [id])
  source      LeadSource?     @relation(fields: [sourceId], references: [id])
  tags        LeadTag[]
  notes       LeadNote[]
  activities  LeadActivity[]
  transitions StageTransition[]

  @@index([tenantId, deletedAt, createdAt(sort: Desc)])
  @@index([tenantId, stageId])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, phoneNorm])
  @@index([tenantId, emailNorm])
  @@index([tenantId, nextFollowUpAt])
  @@map("leads")
}

model Tag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  color    String @default("neutral")

  leads LeadTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model LeadTag {
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tenantId])
  @@map("lead_tags")
}

model LeadNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_notes")
}

/// Typed timeline entries. Append-only by convention (no UPDATE/DELETE grant).
model LeadActivity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  type        String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}

model StageTransition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  fromStageId  String?  @map("from_stage_id") @db.Uuid
  toStageId    String   @map("to_stage_id") @db.Uuid
  lostReasonId String?  @map("lost_reason_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, toStageId, createdAt])
  @@map("stage_transitions")
}

model Property {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  project     String
  unitLabel   String?        @map("unit_label")
  title       String
  propertyType String        @map("property_type")
  bedrooms    Int?
  areaSqft    Int?           @map("area_sqft")
  priceMinor  BigInt         @map("price_minor")
  location    String
  status      PropertyStatus @default(AVAILABLE)
  attributes  Json           @default("{}")
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, location])
  @@index([tenantId, priceMinor])
  @@map("properties")
}

/// API keys for lead capture and (later) the public API. Only a SHA-256 hash is stored.
model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @unique @map("key_hash")
  scopes      String[]
  createdBy   String    @map("created_by") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  requestCount BigInt   @default(0) @map("request_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("api_keys")
}


// ======================================================================= Phase 3: Communication

enum ChannelType {
  WHATSAPP
  WEB_WIDGET
}

enum ChannelStatus {
  ACTIVE
  DISABLED
  ERROR
  /// connected with Facebook and the token was revoked or expired: connect again
  NEEDS_RECONNECT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationMode {
  AI
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CUSTOMER
  AGENT
  AI
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
}

/// Encrypted provider secrets (envelope encryption). The plaintext never leaves the process and is never returned by the API.
model IntegrationCredential {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  provider   String
  /// base64(iv | tag | ciphertext) of the JSON secret blob, encrypted with a per-record data key
  ciphertext String
  /// the data key, itself encrypted with the master key (KMS in production)
  wrappedKey String    @map("wrapped_key")
  keyId      String    @map("key_id")
  status     String    @default("active")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("integration_credentials")
}

model Channel {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  type         ChannelType
  name         String
  status       ChannelStatus @default(ACTIVE)
  /// WhatsApp: phone_number_id
  externalId   String?       @map("external_id")
  /// Unguessable id in the webhook URL: routes the webhook to this channel without trusting the request body
  webhookKey   String?       @unique @map("webhook_key")
  /// Non-secret settings (display phone, WABA id, verify token)
  config       Json          @default("{}")
  credentialId String?       @map("credential_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversations Conversation[]

  @@unique([tenantId, type, externalId])
  @@index([tenantId])
  @@map("channels")
}

model WidgetConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  publicKey      String   @unique @map("public_key")
  allowedOrigins String[] @map("allowed_origins")
  enabled        Boolean  @default(true)
  theme          Json     @default("{}")
  title          String   @default("Chat with us")
  greeting       String   @default("Hi! How can we help you today?")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("widget_configs")
}

model Conversation {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  channelId            String             @map("channel_id") @db.Uuid
  leadId               String             @map("lead_id") @db.Uuid
  /// WhatsApp: customer wa_id. Widget: visitor session id.
  externalThreadId     String             @map("external_thread_id")
  status               ConversationStatus @default(OPEN)
  mode                 ConversationMode   @default(HUMAN)
  assignedMembershipId String?            @map("assigned_membership_id") @db.Uuid
  /// Drives the WhatsApp 24-hour customer-service window
  lastInboundAt        DateTime?          @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt        DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview   String?            @map("last_message_preview")
  unreadCount          Int                @default(0) @map("unread_count")
  tags                 String[]           @default([])
  closedAt             DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  channel  Channel        @relation(fields: [channelId], references: [id])
  messages Message[]
  notes    ConversationNote[]

  @@unique([channelId, externalThreadId])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, leadId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  channelId      String           @map("channel_id") @db.Uuid
  direction      MessageDirection
  senderType     SenderType
  senderUserId   String?          @map("sender_user_id") @db.Uuid
  type           MessageType      @default(TEXT)
  body           String?
  /// {id, mime, filename, caption, sha256} for media messages (the file itself stays at the provider until fetched)
  media          Json?
  template       Json?
  status         MessageStatus    @default(SENT)
  error          Json?
  /// Provider message id (wamid...). Unique per channel: this is the webhook de-duplication key.
  externalId     String?          @map("external_id")
  /// Client-supplied key making "send" safe to retry
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  statusUpdatedAt DateTime        @default(now()) @map("status_updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model ConversationNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_notes")
}

/// Append-only consent history. The latest row per (lead, channel) is the effective state.
model Consent {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  leadId    String        @map("lead_id") @db.Uuid
  channel   String
  status    ConsentStatus
  source    String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, leadId, channel, createdAt(sort: Desc)])
  @@map("consents")
}

model WhatsappTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  language     String   @default("en")
  category     String   @default("UTILITY")
  bodyPreview  String   @map("body_preview")
  variableCount Int     @default(0) @map("variable_count")
  /// 'manual' (typed in by the workspace) or 'meta' (synced from the WhatsApp Business Account)
  source       String   @default("manual")
  /// Meta's status for synced rows (APPROVED, PENDING, REJECTED, PAUSED...); null for manual rows
  approvalStatus String? @map("approval_status")
  syncedAt     DateTime? @map("synced_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, name, language])
  @@map("whatsapp_templates")
}

/// Raw inbound provider deliveries. `payloadHash` is unique per channel: an identical redelivery is acknowledged and ignored.
model WebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  channelId   String   @map("channel_id") @db.Uuid
  provider    String
  payloadHash String   @map("payload_hash")
  payload     Json
  status      String   @default("received")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([channelId, payloadHash])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}


// ======================================================================= Phase 4: AI

enum AiRunStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ScoreSource {
  RULES
  MANUAL
}

model AiAssistant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  enabled             Boolean  @default(false)
  name                String   @default("Assistant")
  businessIdentity    String   @default("") @map("business_identity")
  businessDescription String   @default("") @map("business_description")
  languages           String[] @default(["en"])
  tone                String   @default("friendly")
  welcomeMessage      String   @default("") @map("welcome_message")
  systemInstructions  String   @default("") @map("system_instructions")
  /// { enabled, timezone, days: { mon: {start,end}|null, ... } }
  workingHours        Json     @default("{}") @map("working_hours")
  /// { keywords: string[], onNegotiation: bool, onComplaint: bool }
  handoverRules       Json     @default("{}") @map("handover_rules")
  allowedTools        String[] @default([]) @map("allowed_tools")
  model               String?
  temperature         Float    @default(0.3)
  maxReplyChars       Int      @default(600) @map("max_reply_chars")
  fallbackMessage     String   @default("Thanks for your message. A member of our team will get back to you shortly.") @map("fallback_message")
  disclosureText      String   @default("") @map("disclosure_text")
  monthlyTokenCap     Int?     @map("monthly_token_cap")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_assistants")
}

model AiRun {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  triggerMessageId String?     @map("trigger_message_id") @db.Uuid
  status           AiRunStatus @default(RUNNING)
  model            String?
  promptVersion    String      @map("prompt_version")
  inputTokens      Int         @default(0) @map("input_tokens")
  outputTokens     Int         @default(0) @map("output_tokens")
  latencyMs        Int?        @map("latency_ms")
  error            String?
  /// tool calls, retrieved chunk ids, guard decisions, final reply (customer text is NOT duplicated here)
  trace            Json        @default("{}")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?   @map("completed_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("ai_runs")
}

model AiToolExecution {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  tool           String
  input          Json
  result         Json
  status         String
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, runId])
  @@map("ai_tool_executions")
}

model KnowledgeDocument {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  title            String
  filename         String
  mime             String
  sizeBytes        Int            @map("size_bytes")
  sha256           String
  storageKey       String         @map("storage_key")
  status           DocumentStatus @default(PENDING)
  error            String?
  chunkCount       Int            @default(0) @map("chunk_count")
  category         String?
  uploadedByUserId String?        @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  ordinal        Int
  content        String
  embedding      Unsupported("vector(1536)")?
  embeddingModel String   @map("embedding_model")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

model ScoringRuleSet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  version   Int
  /// criteria with points, thresholds for hot/warm
  rules     Json
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, version])
  @@map("scoring_rule_sets")
}

model LeadScore {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  score       Int
  temperature String
  breakdown   Json
  ruleVersion Int         @map("rule_version")
  source      ScoreSource
  reason      String?
  actorUserId String?     @map("actor_user_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@map("lead_scores")
}


// ======================================================================= Phase 5: appointments, automations, notifications, SLA

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  SKIPPED
  DRY_RUN
}

enum TaskStatus {
  OPEN
  DONE
}

/// Weekly working windows. membership_id NULL = the workspace default; a person's own rules replace the default for that person.
model AvailabilityRule {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid
  /// 0 = Sunday ... 6 = Saturday, in the workspace timezone
  dayOfWeek    Int     @map("day_of_week")
  startMinute  Int     @map("start_minute")
  endMinute    Int     @map("end_minute")

  @@index([tenantId, membershipId])
  @@map("availability_rules")
}

/// A day (or part of a day) when someone is unavailable. date is a calendar day in the workspace timezone.
model AvailabilityException {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid
  date         String
  startMinute  Int?    @map("start_minute")
  endMinute    Int?    @map("end_minute")
  reason       String?

  @@index([tenantId, date])
  @@map("availability_exceptions")
}

/// Double booking is prevented by exclusion constraints in SQL (see the *_appointments migration), not just by application checks.
model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  leadId             String            @map("lead_id") @db.Uuid
  membershipId       String            @map("membership_id") @db.Uuid
  propertyId         String?           @map("property_id") @db.Uuid
  title              String
  serviceType        String?           @map("service_type")
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  status             AppointmentStatus @default(PENDING)
  notes              String?
  location           String?
  source             String            @default("manual")
  cancelledReason    String?           @map("cancelled_reason")
  rescheduledFromId  String?           @map("rescheduled_from_id") @db.Uuid
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  events AppointmentEvent[]

  @@index([tenantId, startsAt])
  @@index([tenantId, membershipId, startsAt])
  @@index([tenantId, leadId])
  @@map("appointments")
}

model AppointmentEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  type          String
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  data          Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, appointmentId, createdAt])
  @@map("appointment_events")
}

model Automation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  templateKey     String?  @map("template_key")
  name            String
  description     String?
  enabled         Boolean  @default(false)
  /// { type, ...config }
  trigger         Json
  /// [{ field, op, value }]
  conditions      Json     @default("[]")
  /// [{ type, ...params }]
  actions         Json
  /// Minimum minutes between runs of this automation for the same lead (protects customers from repeats)
  cooldownMinutes Int      @default(60) @map("cooldown_minutes")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Graph definition (ADR-0010). Null = legacy linear row (trigger/conditions/actions are authoritative and lifted to a graph at run time).
  graph           Json?
  graphVersion    Int      @default(1) @map("graph_version")
  activeVersionId String?  @map("active_version_id") @db.Uuid

  runs     AutomationRun[]
  versions AutomationVersion[]

  @@index([tenantId, enabled])
  @@map("automations")
}

model AutomationRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  automationId String    @map("automation_id") @db.Uuid
  /// outbox event id (or a synthetic key for scanners): with automation_id this makes execution idempotent
  eventId      String    @map("event_id")
  eventType    String    @map("event_type")
  leadId       String?   @map("lead_id") @db.Uuid
  status       RunStatus @default(QUEUED)
  attempts     Int       @default(0)
  error        String?
  steps        Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// set when a worker claims the run; a run stuck RUNNING past a timeout is re-queued by the sweeper
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  /// the immutable definition this run executes (a run never follows later edits)
  versionId    String?   @map("version_id") @db.Uuid
  /// WAITING runs: when the wait ends, and which wait node the run is parked on
  resumeAt     DateTime? @map("resume_at") @db.Timestamptz(3)
  waitingNode  String?   @map("waiting_node")

  automation Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version    AutomationVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([automationId, eventId])
  @@index([status, resumeAt])
  @@index([tenantId, leadId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("automation_runs")
}

/// Immutable saved definition of an automation (ADR-0010). Runs pin to a version. App role: SELECT + INSERT only.
model AutomationVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  automationId    String   @map("automation_id") @db.Uuid
  version         Int
  /// linear | graph
  source          String   @default("graph")
  graph           Json
  cooldownMinutes Int      @default(60) @map("cooldown_minutes")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  automation Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runs       AutomationRun[]

  @@unique([automationId, version])
  @@index([tenantId, automationId])
  @@map("automation_versions")
}

model Task {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  leadId               String?    @map("lead_id") @db.Uuid
  assigneeMembershipId String?    @map("assignee_membership_id") @db.Uuid
  title                String
  notes                String?
  dueAt                DateTime?  @map("due_at") @db.Timestamptz(3)
  status               TaskStatus @default(OPEN)
  source               String     @default("manual")
  /// set when the due-reminder notification has been sent
  remindedAt           DateTime?  @map("reminded_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt          DateTime?  @map("completed_at") @db.Timestamptz(3)

  @@index([tenantId, assigneeMembershipId, status])
  @@index([tenantId, leadId])
  @@map("tasks")
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  type         String
  title        String
  body         String?
  link         String?
  data         Json      @default("{}")
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, membershipId, createdAt(sort: Desc)])
  @@index([tenantId, membershipId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  tenantId     String  @map("tenant_id") @db.Uuid
  membershipId String  @map("membership_id") @db.Uuid
  type         String
  inApp        Boolean @default(true) @map("in_app")

  @@id([membershipId, type])
  @@index([tenantId])
  @@map("notification_preferences")
}

model SlaBreach {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  inboundMessageId String    @unique @map("inbound_message_id") @db.Uuid
  breachedAt       DateTime  @default(now()) @map("breached_at") @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  minutesToRespond Int?      @map("minutes_to_respond")

  @@index([tenantId, resolvedAt])
  @@index([tenantId, conversationId])
  @@map("sla_breaches")
}

/// "Already emitted" markers so scanners (reminders, inactivity, SLA) fire each thing exactly once.
model EventMark {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, key])
  @@map("event_marks")
}

// ---------------------------------------------------------------- Phase 6: plans, billing, platform admin
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED // cancelled by the customer; access continues until current_period_end
  EXPIRED // trial ended / grace ended / period ended: workspace is read-only until a plan is paid for
}

// Plans are rows, not code. Prices are paise per month, EXCLUDING GST.
model Plan {
  key                 String   @id
  name                String
  description         String   @default("")
  priceMinor          Int      @map("price_minor")
  currency            String   @default("INR")
  trialDays           Int      @default(0) @map("trial_days")
  isPublic            Boolean  @default(true) @map("is_public")
  active              Boolean  @default(true)
  sortOrder           Int      @default(0) @map("sort_order")
  razorpayPlanId      String?  @map("razorpay_plan_id")
  razorpayPlanAmount  Int?     @map("razorpay_plan_amount") // GST-inclusive paise the provider plan was created with
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlements PlanEntitlement[]

  @@map("plans")
}

// key = limit (numeric; null limit with enabled = unlimited) or feature (enabled flag). Catalogue lives in @leadpilot/validation.
model PlanEntitlement {
  planKey String   @map("plan_key")
  key     String
  enabled Boolean  @default(true)
  limit   Int?

  plan Plan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@id([planKey, key])
  @@map("plan_entitlements")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planKey                String             @map("plan_key")
  pendingPlanKey         String?            @map("pending_plan_key")
  status                 SubscriptionStatus
  provider               String             @default("none") // none | razorpay | manual
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  graceEndsAt            DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  lastPaymentFailedAt    DateTime?          @map("last_payment_failed_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("subscriptions")
}

model BillingProfile {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  legalName   String   @map("legal_name")
  gstin       String?
  stateCode   String   @map("state_code") // GST state code, 2 digits
  addressLine String   @map("address_line")
  city        String   @default("")
  pincode     String   @default("")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_profiles")
}

model Invoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  number            String   @unique
  planKey           String   @map("plan_key")
  description       String
  periodStart       DateTime? @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime? @map("period_end") @db.Timestamptz(3)
  currency          String   @default("INR")
  taxableMinor      Int      @map("taxable_minor")
  cgstMinor         Int      @default(0) @map("cgst_minor")
  sgstMinor         Int      @default(0) @map("sgst_minor")
  igstMinor         Int      @default(0) @map("igst_minor")
  totalMinor        Int      @map("total_minor")
  gstRatePercent    Int      @map("gst_rate_percent")
  sac               String
  placeOfSupply     String   @map("place_of_supply")
  buyer             Json
  seller            Json
  providerPaymentId String?  @unique @map("provider_payment_id")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  @@index([tenantId, issuedAt])
  @@map("invoices")
}

model Payment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  invoiceId         String?  @map("invoice_id") @db.Uuid
  providerPaymentId String   @unique @map("provider_payment_id")
  amountMinor       Int      @map("amount_minor")
  status            String // captured | failed
  failureReason     String?  @map("failure_reason")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("payments")
}

// Provider webhooks, de-duplicated by (provider, event id). Global: the tenant is resolved from the subscription id.
model BillingEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  type        String
  payload     Json
  status      String    @default("received") // received | processed | ignored | failed
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("billing_events")
}

// Gap-free invoice numbering per financial year (GST rule); advanced by next_invoice_number() inside the invoice transaction.
model InvoiceCounter {
  financialYear String @id @map("financial_year")
  last          Int    @default(0)

  @@map("invoice_counters")
}

// Platform staff. Deliberately NOT users: separate credentials, token audience and audit trail (ADR-0003).
model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("platform_admins")
}

model PlatformAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  tenantId   String?  @map("tenant_id") @db.Uuid
  reason     String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

/// Platform monitoring: one row per alert rule that has ever breached (monitoring milestone 3). Platform-only, RLS: visible with no tenant in scope.
model OpsAlert {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String    @unique
  severity         Int
  status           String    @default("resolved")
  title            String
  streakFailing    Int       @default(0) @map("streak_failing")
  streakOk         Int       @default(0) @map("streak_ok")
  since            DateTime? @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  lastNotifiedAt   DateTime? @map("last_notified_at") @db.Timestamptz(3)
  notifyCount      Int       @default(0) @map("notify_count")
  resolveNotifyDue Boolean   @default(false) @map("resolve_notify_due")
  lastValue        Json      @default("{}") @map("last_value")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, severity])
  @@map("ops_alerts")
}

// ======================================================================= Phase 8: public API, outbound webhooks, support access
model IdempotencyKey {
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  apiKeyId    String?  @map("api_key_id") @db.Uuid
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, key])
  @@map("idempotency_keys")
}

model WebhookEndpoint {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  url               String
  description       String?
  events            String[]
  enabled           Boolean  @default(true)
  disabledReason    String?  @map("disabled_reason")
  consecutiveFailures Int    @default(0) @map("consecutive_failures")
  secretPrefix      String   @map("secret_prefix")
  secretCiphertext  String   @map("secret_ciphertext")
  secretWrappedKey  String   @map("secret_wrapped_key")
  secretKeyId       String   @map("secret_key_id")
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  payload        Json
  test           Boolean   @default(false)
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  lastLatencyMs  Int?      @map("last_latency_ms")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model SupportAccessSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  adminName String    @map("admin_name")
  reason    String
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  ip        String?

  @@index([tenantId, startedAt(sort: Desc)])
  @@map("support_access_sessions")
}

// ---------------------------------------------------------------- Phase 8: MFA (TOTP) for tenant users and platform admins
// Global (not tenant-scoped: MFA belongs to the person). The TOTP secret is envelope-encrypted with SecretBox (key id recorded per row).
model MfaCredential {
  subjectType    String    @map("subject_type") // user | platform_admin
  subjectId      String    @map("subject_id") @db.Uuid
  ciphertext     String
  wrappedKey     String    @map("wrapped_key")
  keyId          String    @map("key_id")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep   BigInt    @default(0) @map("last_used_step") // highest accepted 30 s TOTP step: a code can never be replayed
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([subjectType, subjectId])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([subjectType, subjectId, codeHash])
  @@map("mfa_recovery_codes")
}

// ---------------------------------------------------------------- Phase 8 / F2: data lifecycle (see migration 20261117020000)
model DataExport {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  status            String    @default("QUEUED") // QUEUED | RUNNING | READY | FAILED | EXPIRED
  storageKey        String?   @map("storage_key")
  sizeBytes         BigInt?   @map("size_bytes")
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("data_exports")
}

model TenantDeletionRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  reason            String
  status            String    @default("PENDING") // PENDING | CANCELED
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  purgeAfter        DateTime  @map("purge_after") @db.Timestamptz(3)
  canceledAt        DateTime? @map("canceled_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_deletion_requests")
}

// ----------------------------------------------------------------------------- lead-facing customer portal (ADR 0013)
model PortalConfig {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  /// Unguessable, rotatable key in the portal address (/p/<key>): says which business, grants nothing by itself
  publicKey         String   @unique @map("public_key")
  enabled           Boolean  @default(false)
  allowConfirm      Boolean  @default(true) @map("allow_confirm")
  allowCancel       Boolean  @default(true) @map("allow_cancel")
  allowReschedule   Boolean  @default(true) @map("allow_reschedule")
  cancelCutoffHours Int      @default(4) @map("cancel_cutoff_hours")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("portal_configs")
}

/// One-time sign-in codes: only an HMAC of the code is stored, single use, expiring, attempt-limited
model PortalLoginCode {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  /// Hash of the phone/email typed (never the value): per-identity throttling and lockout
  identityHash String    @map("identity_hash")
  channel      String
  codeHash     String    @map("code_hash")
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, identityHash, createdAt(sort: Desc)])
  @@map("portal_login_codes")
}

model PortalSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  leadId     String    @map("lead_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@index([tenantId, leadId])
  @@map("portal_sessions")
}

/// Per-person alert settings (sound and desktop alerts). No tenant: personal to the user. Missing row = defaults.
model UserAlertSettings {
  userId         String   @id @map("user_id") @db.Uuid
  soundEnabled   Boolean  @default(true) @map("sound_enabled")
  soundVolume    Int      @default(50) @map("sound_volume")
  desktopEnabled Boolean  @default(true) @map("desktop_enabled")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_alert_settings")
}

