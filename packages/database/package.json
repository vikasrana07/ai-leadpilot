{
  "name": "@leadpilot/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sync-permissions": {
      "types": "./dist/sync-permissions.d.ts",
      "default": "./dist/sync-permissions.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && tsx --env-file=../../.env src/sync-permissions.ts && tsx --env-file=../../.env src/sync-system-roles.ts && tsx --env-file=../../.env src/backfill-packs.ts",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync-permissions": "tsx --env-file=../../.env src/sync-permissions.ts"
  },
  "dependencies": {
    "@leadpilot/shared-types": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "5.1.0"
  }
}